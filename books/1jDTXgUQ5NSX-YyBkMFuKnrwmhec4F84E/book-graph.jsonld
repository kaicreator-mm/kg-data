      "safetyScope": null,
      "sourceKind": "BOOK_BODY_DIRECT",
      "statement": "油温是油质与寿命的关键变量，其升高源于变矩器故障、执行元件滑转、单向离合器滑转或油冷却器堵塞，属危险信号。",
      "status": "EXTRACTED_UNCHECKED",
