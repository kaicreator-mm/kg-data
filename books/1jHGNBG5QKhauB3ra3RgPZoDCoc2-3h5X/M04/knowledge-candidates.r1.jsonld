  "@graph": [
    {
      "@id": "urn:kg:parts:AB-M04-K001",
      "@type": "https://example.org/knowledge/ResearchCandidate",
      "title": "三态阀执行器的混合状态模型",
      "mechanism": "增压保压减压可抽象为离散模式与连续轮速压力状态的混合系统；模式切换时液压流量、压力滞后和机械状态仍连续演化。",
      "verification_status": "MODEL_GENERATED_UNVERIFIED",
      "source_scope": "TOC_THEME_ONLY"
    },
    {
      "@id": "urn:kg:parts:AB-M04-K002",
      "@type": "https://example.org/knowledge/ResearchCandidate",
      "title": "离散模式的最小驻留时间",
      "mechanism": "采样噪声和阀响应延迟可诱发高频切换；驻留时间、死区和滞回限制切换频率，但过长驻留会降低滑移恢复速度。",
      "verification_status": "MODEL_GENERATED_UNVERIFIED",
      "source_scope": "TOC_THEME_ONLY"
    },
    {
      "@id": "urn:kg:parts:AB-M04-K003",
      "@type": "https://example.org/knowledge/ResearchCandidate",
      "title": "极限环不是无条件故障",
      "mechanism": "离散执行器的开关策略可能产生有界周期振荡，评估时应区分预期稳态极限环与幅值不断增长的不稳定振荡。",
      "verification_status": "MODEL_GENERATED_UNVERIFIED",
      "source_scope": "TOC_THEME_ONLY"
    },
    {
      "@id": "urn:kg:parts:AB-M04-K004",
      "@type": "https://example.org/knowledge/ResearchCandidate",
      "title": "Poincaré映射的局部稳定判据",
      "mechanism": "对可定义横截面的周期轨道，可通过一次周期返回映射的局部导数或特征值判断小扰动是否衰减；存在性与吸引域仍需另证。",
      "verification_status": "MODEL_GENERATED_UNVERIFIED",
      "source_scope": "TOC_THEME_ONLY"
    },
    {
      "@id": "urn:kg:parts:AB-M04-K005",
      "@type": "https://example.org/knowledge/ResearchCandidate",
      "title": "切换边界与传感器时延",
      "mechanism": "检测延迟改变模式切换时刻并扩大实际滑移摆幅；对切换面的扰动灵敏度应计入传感器滤波和液压滞后。",
      "verification_status": "MODEL_GENERATED_UNVERIFIED",
      "source_scope": "TOC_THEME_ONLY"
    },
    {
      "@id": "urn:kg:parts:AB-M04-K006",
      "@type": "https://example.org/knowledge/ResearchCandidate",
      "title": "阀压力变化率不对称",
      "mechanism": "增压和减压能力可能不对称，受蓄压压力、液温和管路容积影响；周期轨道的幅值与频率不能只用一个对称速率常数预测。",
      "verification_status": "MODEL_GENERATED_UNVERIFIED",
      "source_scope": "TOC_THEME_ONLY"
    },
    {
      "@id": "urn:kg:parts:AB-M04-K007",
      "@type": "https://example.org/knowledge/ResearchCandidate",
      "title": "速率饱和与抗积分饱和",
      "mechanism": "即使上层输出连续目标，离散执行器的压力斜率和阀模式也限制可实现集合；积分器应跟踪执行反馈而非积累不可达压力。",
      "verification_status": "MODEL_GENERATED_UNVERIFIED",
      "source_scope": "TOC_THEME_ONLY"
    },
    {
      "@id": "urn:kg:parts:AB-M04-K008",
      "@type": "https://example.org/knowledge/ResearchCandidate",
      "title": "离散与连续执行器的公平对比",
      "mechanism": "比较两类执行器应统一轮胎、车速估计、采样周期、故障模式和能耗约束，并报告切换次数及制动稳定性，而非只比较平均跟踪误差。",
      "verification_status": "MODEL_GENERATED_UNVERIFIED",
      "source_scope": "TOC_THEME_ONLY"
    },
    {
      "@id": "urn:kg:parts:AB-M04-K009",
      "@type": "https://example.org/knowledge/ResearchCandidate",
      "title": "离散阀故障的可辨识残差",
      "mechanism": "模式命令与压力响应不一致可能由阀卡滞、供压不足、泄漏或压力传感器漂移引起；残差必须与其他观测联合定位。",
      "verification_status": "MODEL_GENERATED_UNVERIFIED",
      "source_scope": "TOC_THEME_ONLY"
    },
    {
      "@id": "urn:kg:parts:AB-M04-K010",
      "@type": "https://example.org/knowledge/ResearchCandidate",
      "title": "极限环验证的分层证据",
      "mechanism": "混合模型仿真可测试事件序列与局部稳定；HIL需覆盖真实阀延迟，整车安全验证需独立场地及规程，不可把模型证明等同于车型认证。",
      "verification_status": "MODEL_GENERATED_UNVERIFIED",
      "source_scope": "TOC_THEME_ONLY"
    },
    {
