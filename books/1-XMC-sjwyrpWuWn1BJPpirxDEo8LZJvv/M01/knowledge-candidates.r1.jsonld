  "@graph": [
    {
      "@id": "https://example.org/dke/books/1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv/M01/M01-K001",
      "@type": "KnowledgeRecord",
      "title": "静止液体压力传递的适用条件",
      "kind": "mechanism",
      "statement": "密闭连通且近似静止的不可压缩液体中，外加压力增量可向各方向传递；绝对压力仍受高度差影响。",
      "technical_explanation": "帕斯卡原理讨论同一静止液体中的附加压力增量，不意味着不同高度点的总压力相同；液压执行器理想输出力可近似表示为F=pA，实际还受密封摩擦和背压影响。",
      "assumptions_and_scope": "近似静态、密闭液路、流体连续、压力单位Pa、有效面积m²；高速流动、气泡和泄漏须单独建模。",
      "counterexample": "有空气混入或节流流动时，不能把任意两测点的瞬时压力视为相同。",
      "toc_anchor": "模块一 流体力学基础知识",
      "source_scope": "TOC_THEME_ONLY",
      "verification_status": "MODEL_GENERATED_UNVERIFIED",
      "related": [
        {
          "@id": "https://example.org/dke/books/1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv/M01/M01-K002",
          "relation": "CONDITIONS"
        },
        {
          "@id": "https://example.org/dke/books/1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv/M01/M01-K005",
