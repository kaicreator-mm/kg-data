        }
      ]
    },
    {
      "@id": "https://example.org/dke/books/1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv/M01/M01-K004",
      "@type": "KnowledgeRecord",
      "title": "静压液压传动与动量型液力传动的区别",
      "kind": "comparison",
      "statement": "常见液压执行机构主要通过受控压差对活塞或液压马达做功，液力变矩器则依靠旋转流体动量变化实现转矩交换。",
      "technical_explanation": "前者通常分析压力、流量、有效面积及泄漏；后者通常分析泵轮、涡轮、导轮的角动量和速度比。两者都可能使用油液但模型边界不同。",
      "assumptions_and_scope": "仅比较典型工作机理，不意味着所有液压系统均无惯性作用，或所有液力传动都带增矩导轮。",
      "counterexample": "不能将变矩器的转矩比曲线当成液压缸的压力—推力标定曲线。",
      "toc_anchor": "模块一 流体力学基础知识",
      "source_scope": "TOC_THEME_ONLY",
      "verification_status": "MODEL_GENERATED_UNVERIFIED",
      "related": [
        {
          "@id": "https://example.org/dke/books/1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv/M01/M01-K003",
