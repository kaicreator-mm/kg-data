        }
      ]
    },
    {
      "@id": "https://example.org/dke/books/1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv/M01/M01-K002",
      "@type": "KnowledgeRecord",
      "title": "体积流量与平均速度的连续性",
      "kind": "formula",
      "statement": "单相不可压缩稳态流动在无分支、无泄漏管段中满足Q=Av，串联截面体积流量近似守恒。",
      "technical_explanation": "Q的单位为m³/s，A为m²，v为截面平均速度m/s；截面积减小时平均速度增大，但不自动证明局部静压增加。",
      "assumptions_and_scope": "恒密度、稳态、同一流路、速度按截面平均；有蓄能器、旁通、泄漏或瞬态压缩时需质量守恒完整形式。",
      "counterexample": "分支阀体两支路流量可以不同，不能要求每条分支都等于总入口流量。",
      "toc_anchor": "模块一 流体力学基础知识",
      "source_scope": "TOC_THEME_ONLY",
      "verification_status": "MODEL_GENERATED_UNVERIFIED",
      "related": [
        {
          "@id": "https://example.org/dke/books/1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv/M01/M01-K003",
          "relation": "RELATED"
        },
        {
          "@id": "https://example.org/dke/books/1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv/M01/M01-K005",
          "relation": "EXPLAINS"
        }
      ]
    },
    {
      "@id": "https://example.org/dke/books/1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv/M01/M01-K003",
      "@type": "KnowledgeRecord",
      "title": "液压功率的单位与效率边界",
      "kind": "formula",
      "statement": "液压端口功率在明确压差及体积流量的条件下近似为P=ΔpQ，不能直接当成轴输出功率。",
      "technical_explanation": "Δp使用Pa、Q使用m³/s时P为W；泵或马达的机械、容积损失使输入输出轴功率与理想液压功率不同。",
      "assumptions_and_scope": "采用控制体边界两端压差及同一流量定义；压力与流量方向需一致，非稳态蓄能项不能忽略。",
      "counterexample": "高系统压力而执行器无流量时，不能仅凭压力断言执行器持续输出高液压功率。",
      "toc_anchor": "模块一 流体力学基础知识",
      "source_scope": "TOC_THEME_ONLY",
      "verification_status": "MODEL_GENERATED_UNVERIFIED",
      "related": [
        {
          "@id": "https://example.org/dke/books/1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv/M01/M01-K002",
          "relation": "USES"
        },
        {
