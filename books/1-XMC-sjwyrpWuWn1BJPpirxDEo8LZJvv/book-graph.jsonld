      ],
      "measurement": null,
      "predicate": "torque_conversion_principle",
      "safetyScope": null,
      "sourceKind": "BOOK_BODY_DIRECT",
      "statement": "借助于导轮叶片使油液通过涡轮之后，再使油液回流至泵轮，通过这种回流冲击泵轮进而达到增大转矩的目的；但在涡轮和泵轮转速差较小时恰恰相反，实现的是减矩作用。",
      "status": "EXTRACTED_UNCHECKED",
