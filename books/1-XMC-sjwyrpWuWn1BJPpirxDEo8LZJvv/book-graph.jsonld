      "canonicalJson": "{\"applicability\":null,\"conditions\":[\"低速/泵轮与涡轮转速差大\",\"液流作用于导轮叶片前表面\"],\"evidence_ids\":[\"book:1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv:ev:p0065:e05\",\"book:1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv:ev:p0067:e05\"],\"id\":\"claim:1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv:c03s2t4:0071\",\"object_id\":\"book:1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv:ent:k08\",\"pdf_pages\":[65,66,67,68],\"predicate\":\"locks\",\"qualification_status\":\"EXTRACTED_UNCHECKED\",\"source_kind\":\"BOOK_BODY_DIRECT\",\"statement\":\"低速（转速差大）时作用在导轮叶片前表面的液体使导轮欲按泵轮旋转的相反方向转动，通过单向离合器锁止使导轮固定，产生增大转矩的效果（图3-11、图3-15a）。\",\"subject_id\":\"book:1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv:ent:k09\"}",
