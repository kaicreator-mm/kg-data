      "applicability": null,
      "assumptions": [],
      "canonicalJson": "{\"applicability\":null,\"conditions\":[\"高速/涡轮转速接近泵轮转速\",\"液流作用于导轮叶片后表面\"],\"evidence_ids\":[\"book:1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv:ev:p0065:e05\",\"book:1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv:ev:p0067:e05\"],\"id\":\"claim:1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv:c03s2t4:0072\",\"object_id\":\"book:1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv:ent:k08\",\"pdf_pages\":[65,66,67,68],\"predicate\":\"releases\",\"qualification_status\":\"EXTRACTED_UNCHECKED\",\"source_kind\":\"BOOK_BODY_DIRECT\",\"statement\":\"高速（涡轮转速接近泵轮转速）时作用在导轮叶片后表面的液体通过单向离合器的超越（释放）使导轮自由旋转；若导轮固定将阻挡工作液流动；此时变矩器实际上变成了耦合器，只能传递力矩，作用在导轮叶片的转矩将不能增大（图3-11、图3-15b）。\",\"subject_id\":\"book:1-XMC-sjwyrpWuWn1BJPpirxDEo8LZJvv:ent:k09\"}",
