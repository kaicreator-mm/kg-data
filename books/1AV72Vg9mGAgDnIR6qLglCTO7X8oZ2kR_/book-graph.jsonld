      "assumptions": [],
      "canonicalJson": "{\"applicability\":{\"engine\":null,\"make\":\"Honda\",\"model\":\"本田车系\"},\"conditions\":[\"触发条件：发动机低转速或低负荷\"],\"counterexamples\":[],\"evidence_ids\":[\"book:1AV72Vg9mGAgDnIR6qLglCTO7X8oZ2kR_:ev:p5:e1\"],\"id\":\"claim:1AV72Vg9mGAgDnIR6qLglCTO7X8oZ2kR_:c01:0004\",\"object_id\":\"book:1AV72Vg9mGAgDnIR6qLglCTO7X8oZ2kR_:ent:k03\",\"predicate\":\"forms_operating_mode\",\"qualification_status\":\"EXTRACTED_UNCHECKED\",\"source_kind\":\"BOOK_BODY_DIRECT\",\"statement\":\"发动机处于低转速或低负荷时三个摇臂之间无任何连接，进气主摇臂和进气辅摇臂分别顶动两个进气门，使两者具有不同的正时及升程，形成低速工作模式。\",\"subject_id\":\"book:1AV72Vg9mGAgDnIR6qLglCTO7X8oZ2kR_:ent:k02\",\"unknowns\":[],\"value\":\"低速工作模式（图1-1）\"}",
