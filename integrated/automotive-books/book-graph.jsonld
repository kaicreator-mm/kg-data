      "canonicalJson": "{\"attributes_json\":\"{\\\"brief\\\": \\\"凡是能使某种形式的能量转变成机械能的机器的统称\\\", \\\"pages\\\": [21]}\",\"id\":\"book:1Ds7ED02SAYic6aZm5nRpIb0KZX8C8EIz:ent:k01\",\"kind\":\"concept\",\"label\":\"发动机\"}",
