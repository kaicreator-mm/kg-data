      "applicability": null,
      "assumptions": [],
      "canonicalJson": "{\"applicability\":null,\"conditions\":[\"供电电源为蓄电池或发电机（12V低压电）\",\"适用对象: 汽油机点火系统\"],\"counterexamples\":[],\"evidence_ids\":[\"book:17Xm9TVoW7KCQSjN2P_QeRsnoXEo2mGmC:ev:p139:e2\"],\"id\":\"claim:17Xm9TVoW7KCQSjN2P_QeRsnoXEo2mGmC:c07:0003\",\"object_id\":null,\"predicate\":\"realizes_mechanism\",\"qualification_status\":\"EXTRACTED_UNCHECKED\",\"source_kind\":\"BOOK_BODY_DIRECT\",\"statement\":\"点火系工作机理是将蓄电池或发电机供给的12V低压电转变为上万伏的高压电，并按工作需要分送到各缸火花塞，使电极间产生电火花。\",\"subject_id\":\"book:17Xm9TVoW7KCQSjN2P_QeRsnoXEo2mGmC:ent:k01\",\"unknowns\":[\"“上万伏”为约数，书中未给出具体电压数值及测量条件\"],\"value\":\"将蓄电池或发电机供给的12V低压电转变为上万伏高压电，并按工作需要分送到各缸火花塞，使其电极间产生电火花\"}",
